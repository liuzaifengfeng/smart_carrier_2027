/**
 * Fashion Star Wiki - GitHub Icon Injector
 * Adds GitHub icon button to the header toolbar (all screen sizes)
 * 
 * DOM order: Palette (dark/light) → GitHub → Language → Search
 * 
 * On mobile/tablet (< 60em): Palette is visually hidden via CSS, GitHub shown
 * On desktop (>= 60em): Both Palette and GitHub shown
 */

document.addEventListener('DOMContentLoaded', function() {
  // Always add GitHub icon (CSS controls visibility at different breakpoints)
  function checkAndAddGitHubIcon() {
    // Check if GitHub icon already exists (prevent duplicates in instant navigation)
    if (document.querySelector('.md-header__github')) {
      return;
    }

    // Find the header inner nav
    const headerNav = document.querySelector('.md-header__inner.md-grid');
    if (!headerNav) {
      return;
    }

    // Find the color toggle button (palette)
    const paletteToggle = headerNav.querySelector('.md-header__option[data-md-component="palette"]');
    
    // Create GitHub icon container
    const githubContainer = document.createElement('div');
    githubContainer.className = 'md-header__option md-header__github';
    githubContainer.setAttribute('data-md-component', 'github');
    
    // Create GitHub link
    const githubLink = document.createElement('a');
    githubLink.href = 'https://github.com/servodevelop';
    githubLink.title = 'Fashion Star on GitHub';
    githubLink.setAttribute('aria-label', 'Fashion Star on GitHub');
    githubLink.className = 'md-header__button md-icon';
    githubLink.target = '_blank';
    githubLink.rel = 'noopener noreferrer';
    
    // GitHub SVG icon (Octocat, using currentColor for theme adaptation)
    githubLink.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>';
    
    githubContainer.appendChild(githubLink);
    
    // Insert AFTER palette toggle to achieve correct order:
    // Palette → GitHub → Language → Search
    if (paletteToggle) {
      // Insert after palette toggle
      const nextSibling = paletteToggle.nextSibling;
      if (nextSibling) {
        headerNav.insertBefore(githubContainer, nextSibling);
      } else {
        headerNav.appendChild(githubContainer);
      }
    } else {
      // Fallback: append to end if palette not found
      headerNav.appendChild(githubContainer);
    }
  }

  // Run on load
  checkAndAddGitHubIcon();
  
  // Run on resize (debounced)
  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(checkAndAddGitHubIcon, 250);
  });
});
